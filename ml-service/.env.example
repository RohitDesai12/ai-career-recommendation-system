# Groq API Key for document classification and resume parsing (optional fallback)
GROQ_API_KEY=your_groq_api_key_here

# Cloud Model Storage Download URLs (Optional: for cloud hosting when .pkl is not in Git)
# Example: https://huggingface.co/<user>/<repo>/resolve/main/career_model_v3.pkl
# Example: https://pub-xxxxxx.r2.dev/career_model_v3.pkl
CAREER_MODEL_URL=
RESUME_MODEL_URL=

# Set to 'true' on 512 MB RAM free cloud instances (e.g. Render/Railway free tier)
# to avoid Out-Of-Memory (OOM) crashes and run in lightweight domain fallback mode
SKIP_HEAVY_MODEL_LOAD=false

# Model download timeout in seconds (default: 300)
MODEL_DOWNLOAD_TIMEOUT=300
