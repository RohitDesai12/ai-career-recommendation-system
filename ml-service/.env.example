# Groq API Key for document classification and resume parsing (optional fallback)
GROQ_API_KEY=your_groq_api_key_here

# Cloud Model Storage Download URLs (Optional: for cloud hosting when .pkl is not in Git)
# Example: https://huggingface.co/<user>/<repo>/resolve/main/career_model_v8.pkl
V8_MODEL_URL=
RESUME_MODEL_URL=

# Model download timeout in seconds (default: 300)
MODEL_DOWNLOAD_TIMEOUT=300
