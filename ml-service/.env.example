# Groq API Key for document classification and resume parsing (optional fallback)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Private Model Repository Configuration
HF_REPO_ID=rohitdesai205/compass
HF_MODEL_FILENAME=career_model_v8.pkl
HF_METADATA_FILENAME=career_model_v8_metadata.json
HF_RESUME_MODEL_FILENAME=resume_model.pkl
HF_RESUME_ENCODERS_FILENAME=resume_encoders.pkl
HF_RESUME_META_FILENAME=resume_model_meta.json
HF_TOKEN=

# Mode Selection: Set to true for local development using local models/v8/ files
USE_LOCAL_V8_MODEL=false

# Resume Analyzer Cloud Model Storage Download URL (Optional)
RESUME_MODEL_URL=

# Model download timeout in seconds (default: 300)
MODEL_DOWNLOAD_TIMEOUT=300

